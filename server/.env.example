# Arquivo SQLite. Os wallpapers enviados ficam na mesma pasta (ou em BOARD_DADOS).
BOARD_DB=~/.agent-board/board.db

# Porta e interface de rede. Fora de 127.0.0.1 o servidor exige BOARD_API_KEY.
BOARD_PORT=8078
BOARD_HOST=127.0.0.1

# Quando definida, toda requisição precisa de "Authorization: Bearer <chave>".
# Gere uma com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOARD_API_KEY=

# Sem chave: nomes de host extras aceitos, separados por vírgula (ex.: meu-pc.local)
BOARD_HOSTS=

# Origens de navegador autorizadas a chamar a API de outro endereço (ex.: http://localhost:3000)
BOARD_CORS_ORIGENS=

# 1 = aceitar escutar fora de localhost sem chave. Só se a porta já estiver protegida (VPN, firewall).
BOARD_PERMITIR_ABERTO=

# Fuso usado para decidir se um lembrete é "de hoje".
BOARD_FUSO=America/Sao_Paulo

# Backup automático: pasta, intervalo em horas (0 desliga) e quantos guardar.
# Sem BOARD_BACKUP_DIR os backups ficam em "backups", ao lado do banco.
BOARD_BACKUP_DIR=
BOARD_BACKUP_HORAS=24
BOARD_BACKUP_MANTER=14
